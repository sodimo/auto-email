{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "auto-email",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-01",
  // worker-mailer opens raw TCP via `cloudflare:sockets`; nodejs_compat is required.
  "compatibility_flags": ["nodejs_compat"],

  // workers.dev remains available for token-gated operation and verification
  // until Cloudflare Access has been installed and verified on the custom
  // domain. Every route, including unknown paths, requires TRIGGER_TOKEN.
  // auto-email.sodimo.eu is attached at the ACCOUNT level by the manual
  // attach-domain workflow (same arrangement as sibling `crm`). It is NOT a
  // zone `route`: re-asserting one at deploy time would require unrelated zone
  // Workers-Routes:Edit permission. Disable workers_dev in a later reviewed
  // deployment only after the Access policy is proven.
  "workers_dev": true,

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "auto-email",
      // Filled in by .github/workflows/bootstrap.yml output after
      // `wrangler d1 create auto-email` — commit the uuid it prints here.
      // Ignored by the vitest workers pool (tests get a fresh local D1).
      "database_id": "febac9c7-596b-4a7d-9ce4-212ec0d4c20d",
      "migrations_dir": "migrations"
    },
    {
      // Production ERP mirror. This binding is LOGICALLY read-only: D1 has no
      // read-only binding mode, so every query must keep passing through
      // src/lib/datasource.ts#assertReadOnlySql. No migrations_dir — the frozen
      // sodimo/etl pipeline is the sole owner of this database's schema/data.
      "binding": "ERP",
      "database_name": "sodimo-prod",
      "database_id": "c7552dfa-d55e-4a29-9510-9ab25109e952"
    }
  ],

  // DORMANT (see CLAUDE.md "Dormant"). The empty list is deliberate: wrangler
  // PUTs this list to the Worker's schedules on deploy, so [] DELETES every
  // cron trigger. Removing the "triggers" key would instead leave the old
  // */5 trigger running. To wake: restore ["*/5 * * * *"] (the tick; job rows
  // carry their own cron strings, matched over a lookback window, see
  // src/lib/cron.ts; keep TICK_MINUTES in src/config.ts in sync) AND set
  // vars.DORMANT to "off", in the same reviewed commit.
  "triggers": { "crons": [] },

  // Dormant unless exactly "off": every route answers a static 503 page or
  // JSON and scheduled() returns before any D1 call. Waking needs the joint
  // decision of the Sodimo operations lead and the technical lead.
  "vars": { "DORMANT": "on" },

  // SECRETS (never vars, never committed). Set with:
  //   wrangler secret put STRATO_SMTP_PASSWORD   # Strato mailbox rapports@sodimo.eu
  //   wrangler secret put TRIGGER_TOKEN          # shared secret for /trigger + /healthz
  // Locally, put them in .dev.vars (gitignored). Typed in src/types.ts#Env.

  "observability": { "enabled": true }
}
